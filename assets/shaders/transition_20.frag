#version 440
layout(location=0) in vec2 qt_TexCoord0;
layout(location=0) out vec4 fragColor;
layout(std140,binding=0) uniform buf {mat4 qt_Matrix;float qt_Opacity;float effectTime;vec4 p1;vec4 p2;};
layout(binding=1) uniform sampler2D sourceA;
layout(binding=2) uniform sampler2D sourceB;
void main(){vec2 uv=qt_TexCoord0,uvA=uv,uvB=uv;float weight=effectTime;
bool t0=(1e-06>effectTime);
float t1=(t0?uv.x:uv.x);
float t2=(t0?uv.y:uv.y);
bool t3=(effectTime>0.999999);
float t4=(t3?uv.x:uv.x);
float t5=(t3?uv.y:uv.y);
float t6=(effectTime*1.1);
float t7=(t6-0.05);
float t8=(p2.z*3.14159265359);
float t9=(t8/180.0);
float t10=cos(t9);
float t11=(uv.x*t10);
float t12=sin(t9);
float t13=(uv.y*t12);
float t14=(t11+t13);
float t15=(t14*p1.y);
float t16=floor(t15);
float t17=(t15-t16);
float t18=(0.025*p1.x);
float t19=(0.015+t18);
float t20=(t17-t19);
float t21=(t7-t20);
float t22=(t17+t19);
float t23=(t22-t20);
float t24=max(0.0001,t23);
float t25=(t21/t24);
float t26=max(t25,0.0);
float t27=min(t26,1.0);
float t28=(t27*t27);
float t29=(2.0*t27);
float t30=(3.0-t29);
float t31=(t28*t30);
float t32=(t0?0.0:t31);
float t33=(t3?1.0:t32);
float t34=max(t33,0.0);
float t35=min(t34,1.0);
uvA=vec2(t1,t2);
uvB=vec2(t4,t5);
weight=t35;
fragColor=mix(texture(sourceA,clamp(uvA,vec2(0),vec2(1))),texture(sourceB,clamp(uvB,vec2(0),vec2(1))),weight)*qt_Opacity;}
