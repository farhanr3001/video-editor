#version 440
layout(location=0) in vec2 qt_TexCoord0;
layout(location=0) out vec4 fragColor;
layout(std140,binding=0) uniform buf {mat4 qt_Matrix;float qt_Opacity;float effectTime;vec4 p1;vec4 p2;};
layout(binding=1) uniform sampler2D sourceA;
layout(binding=2) uniform sampler2D sourceB;
void main(){vec2 uv=qt_TexCoord0,uvA=uv,uvB=uv;float weight=effectTime;
bool t0=(1e-06>effectTime);
float t1=(uv.x-p2.x);
float t2=(t1*p2.w);
float t3=(t2/p2.w);
float t4=(effectTime*3.14159265359);
float t5=sin(t4);
float t6=(t5*p1.x);
float t7=(t6*2.0);
float t8=(1.0+t7);
float t9=(t3/t8);
float t10=(p2.x+t9);
float t11=(t0?uv.x:t10);
float t12=(uv.y-p2.y);
float t13=(t12/t8);
float t14=(p2.y+t13);
float t15=(t0?uv.y:t14);
bool t16=(effectTime>0.999999);
float t17=(t2/t8);
float t18=(t6*0.15);
float t19=cos(t18);
float t20=(t17*t19);
float t21=sin(t18);
float t22=(t13*t21);
float t23=(t20-t22);
float t24=(t23/p2.w);
float t25=(p2.x+t24);
float t26=(t16?uv.x:t25);
float t27=(t17*t21);
float t28=(t13*t19);
float t29=(t27+t28);
float t30=(p2.y+t29);
float t31=(t16?uv.y:t30);
float t32=(t0?0.0:effectTime);
float t33=(t16?1.0:t32);
float t34=max(t33,0.0);
float t35=min(t34,1.0);
uvA=vec2(t11,t15);
uvB=vec2(t26,t31);
weight=t35;
fragColor=mix(texture(sourceA,clamp(uvA,vec2(0),vec2(1))),texture(sourceB,clamp(uvB,vec2(0),vec2(1))),weight)*qt_Opacity;}
