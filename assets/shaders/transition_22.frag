#version 440
layout(location=0) in vec2 qt_TexCoord0;
layout(location=0) out vec4 fragColor;
layout(std140,binding=0) uniform buf {mat4 qt_Matrix;float qt_Opacity;float effectTime;vec4 p1;vec4 p2;};
layout(binding=1) uniform sampler2D sourceA;
layout(binding=2) uniform sampler2D sourceB;
void main(){vec2 uv=qt_TexCoord0,uvA=uv,uvB=uv;float weight=effectTime;
bool t0=(1e-06>effectTime);
float t1=(t0?uv.x:uv.x);
float t2=(t0?uv.y:uv.y);
bool t3=(effectTime>0.999999);
float t4=(t3?uv.x:uv.x);
float t5=(t3?uv.y:uv.y);
float t6=(effectTime*1.1);
float t7=(t6-0.05);
float t8=(p2.z*3.14159265359);
float t9=(t8/180.0);
float t10=(t9+0.785398163397);
float t11=cos(t10);
float t12=(uv.x*t11);
float t13=sin(t10);
float t14=(uv.y*t13);
float t15=(t12+t14);
float t16=min(0.0,t11);
float t17=(t15-t16);
float t18=min(0.0,t13);
float t19=(t17-t18);
float t20=abs(t11);
float t21=abs(t13);
float t22=(t20+t21);
float t23=max(0.1,t22);
float t24=(t19/t23);
float t25=(0.025*p1.x);
float t26=(0.015+t25);
float t27=(t24-t26);
float t28=(t7-t27);
float t29=(t24+t26);
float t30=(t29-t27);
float t31=max(0.0001,t30);
float t32=(t28/t31);
float t33=max(t32,0.0);
float t34=min(t33,1.0);
float t35=(t34*t34);
float t36=(2.0*t34);
float t37=(3.0-t36);
float t38=(t35*t37);
float t39=(t0?0.0:t38);
float t40=(t3?1.0:t39);
float t41=max(t40,0.0);
float t42=min(t41,1.0);
uvA=vec2(t1,t2);
uvB=vec2(t4,t5);
weight=t42;
fragColor=mix(texture(sourceA,clamp(uvA,vec2(0),vec2(1))),texture(sourceB,clamp(uvB,vec2(0),vec2(1))),weight)*qt_Opacity;}
