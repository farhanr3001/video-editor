layout(binding=1) uniform sampler2D sourceA;
layout(binding=2) uniform sampler2D sourceB;
void main(){vec2 uv=qt_TexCoord0,uvA=uv,uvB=uv;float weight=effectTime;
bool t0=(1e-06>effectTime);
bool t1=(0.5>effectTime);
float t2=(uv.x-0.5);
float t3=(effectTime*3.14159265359);
float t4=cos(t3);
float t5=abs(t4);
float t6=max(0.02,t5);
float t7=(t2/t6);
float t8=(0.5+t7);
float t9=(t1?t8:uv.x);
float t10=(t0?uv.x:t9);
float t11=(t0?uv.y:uv.y);
