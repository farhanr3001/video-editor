#version 440
layout(location=0) in vec2 qt_TexCoord0;
layout(location=0) out vec4 fragColor;
layout(std140,binding=0) uniform buf {mat4 qt_Matrix;float qt_Opacity;float effectTime;vec4 p1;vec4 p2;};
layout(binding=1) uniform sampler2D sourceA;
layout(binding=2) uniform sampler2D sourceB;
void main(){vec2 uv=qt_TexCoord0,uvA=uv,uvB=uv;float weight=effectTime;
bool t0=(1e-06>effectTime);
float t1=(t0?uv.x:uv.x);
float t2=(t0?uv.y:uv.y);
bool t3=(effectTime>0.999999);
float t4=(t3?uv.x:uv.x);
float t5=(t3?uv.y:uv.y);
float t6=(effectTime*1.1);
float t7=(t6-0.05);
float t8=(uv.x-p2.x);
float t9=(t8*p2.w);
float t10=(t9*t9);
float t11=(uv.y-p2.y);
float t12=(t11*t11);
float t13=(t10+t12);
float t14=(t13+1e-08);
float t15=sqrt(t14);
float t16=(1.0-p2.x);
float t17=max(p2.x,t16);
float t18=(t17*p2.w);
float t19=pow(t18,2.0);
float t20=(1.0-p2.y);
float t21=max(p2.y,t20);
float t22=pow(t21,2.0);
float t23=(t19+t22);
float t24=sqrt(t23);
float t25=max(0.1,t24);
float t26=(t15/t25);
float t27=(0.025*p1.x);
float t28=(0.015+t27);
float t29=(t26-t28);
float t30=(t7-t29);
float t31=(t26+t28);
float t32=(t31-t29);
float t33=max(0.0001,t32);
float t34=(t30/t33);
float t35=max(t34,0.0);
float t36=min(t35,1.0);
float t37=(t36*t36);
float t38=(2.0*t36);
float t39=(3.0-t38);
float t40=(t37*t39);
float t41=(t0?0.0:t40);
float t42=(t3?1.0:t41);
float t43=max(t42,0.0);
float t44=min(t43,1.0);
uvA=vec2(t1,t2);
uvB=vec2(t4,t5);
weight=t44;
fragColor=mix(texture(sourceA,clamp(uvA,vec2(0),vec2(1))),texture(sourceB,clamp(uvB,vec2(0),vec2(1))),weight)*qt_Opacity;}
