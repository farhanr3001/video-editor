#version 440
layout(location=0) in vec2 qt_TexCoord0;
layout(location=0) out vec4 fragColor;
layout(std140,binding=0) uniform buf {mat4 qt_Matrix;float qt_Opacity;float effectTime;vec4 p1;vec4 p2;};
layout(binding=1) uniform sampler2D sourceA;
layout(binding=2) uniform sampler2D sourceB;
void main(){vec2 uv=qt_TexCoord0,uvA=uv,uvB=uv;float weight=effectTime;
bool t0=(1e-06>effectTime);
float t1=(t0?uv.x:uv.x);
float t2=(t0?uv.y:uv.y);
bool t3=(effectTime>0.999999);
float t4=(t3?uv.x:uv.x);
float t5=(t3?uv.y:uv.y);
float t6=(effectTime*1.1);
float t7=(t6-0.05);
float t8=(uv.x-p2.x);
float t9=(t8*p2.w);
float t10=(t9*t9);
float t11=(uv.y-p2.y);
float t12=(t11*t11);
float t13=(t10+t12);
float t14=(t13+1e-08);
float t15=sqrt(t14);
float t16=atan(t11,t9);
float t17=(p2.z*3.14159265359);
float t18=(t17/180.0);
float t19=(t16+t18);
float t20=(effectTime*0.25);
float t21=(t19+t20);
float t22=floor(p1.y);
float t23=max(3.0,t22);
float t24=(t21*t23);
float t25=cos(t24);
float t26=(0.22*t25);
float t27=(0.75+t26);
float t28=(t15/t27);
float t29=max(1.0,p2.w);
float t30=(t28/t29);
float t31=(0.02*p1.x);
float t32=(0.02+t31);
float t33=(t30-t32);
float t34=(t7-t33);
float t35=(t30+t32);
float t36=(t35-t33);
float t37=max(0.0001,t36);
float t38=(t34/t37);
float t39=max(t38,0.0);
float t40=min(t39,1.0);
float t41=(t40*t40);
float t42=(2.0*t40);
float t43=(3.0-t42);
float t44=(t41*t43);
float t45=(t0?0.0:t44);
float t46=(t3?1.0:t45);
float t47=max(t46,0.0);
float t48=min(t47,1.0);
uvA=vec2(t1,t2);
uvB=vec2(t4,t5);
weight=t48;
fragColor=mix(texture(sourceA,clamp(uvA,vec2(0),vec2(1))),texture(sourceB,clamp(uvB,vec2(0),vec2(1))),weight)*qt_Opacity;}
