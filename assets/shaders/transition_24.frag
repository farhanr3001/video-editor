#version 440
layout(location=0) in vec2 qt_TexCoord0;
layout(location=0) out vec4 fragColor;
layout(std140,binding=0) uniform buf {mat4 qt_Matrix;float qt_Opacity;float effectTime;vec4 p1;vec4 p2;};
layout(binding=1) uniform sampler2D sourceA;
layout(binding=2) uniform sampler2D sourceB;
void main(){vec2 uv=qt_TexCoord0,uvA=uv,uvB=uv;float weight=effectTime;
bool t0=(1e-06>effectTime);
float t1=(t0?uv.x:uv.x);
float t2=(t0?uv.y:uv.y);
bool t3=(effectTime>0.999999);
float t4=(t3?uv.x:uv.x);
float t5=(t3?uv.y:uv.y);
float t6=(effectTime*1.1);
float t7=(t6-0.05);
float t8=(uv.y-p2.y);
float t9=(uv.x-p2.x);
float t10=(t9*p2.w);
float t11=atan(t8,t10);
float t12=(p2.z*3.14159265359);
float t13=(t12/180.0);
float t14=(t11+t13);
float t15=(t14/6.28318530718);
float t16=(p1.y*0.5);
float t17=floor(t16);
float t18=max(2.0,t17);
float t19=(t15*t18);
float t20=floor(t19);
float t21=(t19-t20);
float t22=(0.025*p1.x);
float t23=(0.015+t22);
float t24=(t21-t23);
float t25=(t7-t24);
float t26=(t21+t23);
float t27=(t26-t24);
float t28=max(0.0001,t27);
