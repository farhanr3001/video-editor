float t36=(t0?0.0:t35);
float t37=(t3?1.0:t36);
float t38=max(t37,0.0);
float t39=min(t38,1.0);
uvA=vec2(t1,t2);
uvB=vec2(t4,t5);
weight=t39;
fragColor=mix(texture(sourceA,clamp(uvA,vec2(0),vec2(1))),texture(sourceB,clamp(uvB,vec2(0),vec2(1))),weight)*qt_Opacity;}
