float t23=(t22+0.5);
float t24=(t9/p2.w);
float t25=(t23/t24);
float t26=(t25-uv.y);
float t27=(t26*t16);
float t28=(uv.y+t27);
float t29=(t3?uv.y:t28);
float t30=(effectTime-0.15);
float t31=max(0.0001,0.7);
float t32=(t30/t31);
float t33=max(t32,0.0);
float t34=min(t33,1.0);
float t35=(t34*t34);
float t36=(2.0*t34);
float t37=(3.0-t36);
float t38=(t35*t37);
float t39=(t0?0.0:t38);
float t40=(t3?1.0:t39);
float t41=max(t40,0.0);
float t42=min(t41,1.0);
uvA=vec2(t1,t2);
uvB=vec2(t19,t29);
weight=t42;
fragColor=mix(texture(sourceA,clamp(uvA,vec2(0),vec2(1))),texture(sourceB,clamp(uvB,vec2(0),vec2(1))),weight)*qt_Opacity;}
