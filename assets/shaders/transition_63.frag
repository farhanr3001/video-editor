#version 440
layout(location=0) in vec2 qt_TexCoord0;
layout(location=0) out vec4 fragColor;
layout(std140,binding=0) uniform buf {mat4 qt_Matrix;float qt_Opacity;float effectTime;vec4 p1;vec4 p2;};
layout(binding=1) uniform sampler2D sourceA;
layout(binding=2) uniform sampler2D sourceB;
void main(){vec2 uv=qt_TexCoord0,uvA=uv,uvB=uv;float weight=effectTime;
bool t0=(1e-06>effectTime);
float t1=(t0?uv.x:uv.x);
float t2=(t0?uv.y:uv.y);
bool t3=(effectTime>0.999999);
float t4=(t3?uv.x:uv.x);
float t5=(t3?uv.y:uv.y);
float t6=(effectTime*1.1);
float t7=(t6-0.05);
float t8=(uv.y-p2.y);
float t9=(uv.x-p2.x);
float t10=(t9*p2.w);
float t11=atan(t8,t10);
float t12=(p2.z*3.14159265359);
float t13=(t12/180.0);
float t14=(t11+t13);
float t15=(t14/6.28318530718);
float t16=(t10*t10);
float t17=(t8*t8);
float t18=(t16+t17);
float t19=(t18+1e-08);
float t20=sqrt(t19);
float t21=(t20*p1.y);
float t22=(t21*0.12);
float t23=(t15+t22);
float t24=floor(t23);
float t25=(t23-t24);
float t26=(t25-0.03);
float t27=(t7-t26);
float t28=(t25+0.03);
float t29=(t28-t26);
float t30=max(0.0001,t29);
float t31=(t27/t30);
float t32=max(t31,0.0);
float t33=min(t32,1.0);
float t34=(t33*t33);
float t35=(2.0*t33);
float t36=(3.0-t35);
float t37=(t34*t36);
float t38=(t0?0.0:t37);
float t39=(t3?1.0:t38);
float t40=max(t39,0.0);
float t41=min(t40,1.0);
uvA=vec2(t1,t2);
uvB=vec2(t4,t5);
weight=t41;
fragColor=mix(texture(sourceA,clamp(uvA,vec2(0),vec2(1))),texture(sourceB,clamp(uvB,vec2(0),vec2(1))),weight)*qt_Opacity;}
